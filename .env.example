# Static pages and /sandbox run without credentials.
# Configure separate staging and production Supabase projects for connected accounts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Normal app requests use the user's session and RLS, never a service secret.
# Provisioning is performed in trusted operator tooling, outside browser/runtime code.
# AI is off until an owner configures providers and budgets. Never expose these as NEXT_PUBLIC.
AI_RUNTIME_DB_URL=
AI_CREDENTIAL_ENCRYPTION_KEY=
AI_ALLOWED_ORIGINS=https://api.openai.com,https://openrouter.ai,https://api.anthropic.com,https://generativelanguage.googleapis.com
# Optional server secret reference; encrypted provider credentials take precedence.
# AI_SECRET_PROVIDER_NAME=
